# csp-front environment variables
# Names and placeholders only: never a real value. Copy to .env for local runs.
# The container reads them at startup (deploy/runtime/40-render-runtime-config.sh) and renders
# config.json, federation.manifest.json and the CORS rule; the image itself is the same in every
# environment. Nothing secret lives in a front end.
# The local development server port is configured in angular.json.

GATEWAY_URL=http://localhost:8000
AUTH_REMOTE_URL=http://localhost:4201/remoteEntry.json
BOOKING_REMOTE_URL=http://localhost:4202/remoteEntry.json
CATALOG_REMOTE_URL=http://localhost:4203/remoteEntry.json
CONCESSIONS_REMOTE_URL=http://localhost:4204/remoteEntry.json
TICKETING_REMOTE_URL=http://localhost:4205/remoteEntry.json
CORS_ALLOWED_ORIGIN_REGEX=^http://localhost:420[0-5]$
